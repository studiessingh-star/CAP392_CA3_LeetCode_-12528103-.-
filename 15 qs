class Solution {
    public int countDigitOne(int n) {

        int count = 0;

        for (int i = 1; i <= n; i++) {

            int num = i;

            while (num > 0) {

                int digit = num % 10;

                if (digit == 1) {
                    count++;
                }

                num = num / 10;
            }
        }

        return count;
    }
}
