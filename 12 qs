class Solution {
    public double myPow(double x, int n) {

        double ans = 1;
        long power = n;

        if (power < 0) {
            power = -power;
            x = 1 / x;
        }

        for (long i = 0; i < power; i++) {
            ans = ans * x;
        }

        return ans;
    }
}
